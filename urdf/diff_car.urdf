<?xml version="1.0"?>
<!-- ============================================================================
     diff_car.urdf —— 一台"两轮差速小车"
     作用：告诉 Gazebo（物理引擎）"这台机器人由哪些零件组成、零件之间怎么连接"

     URDF 只有两个核心概念，记住这两个就够：
       link  = 零件（一个刚体），例如：车体、左轮、右轮
       joint = 两个零件之间的"连接方式"，决定它们之间能不能动、怎么动

     整份文件的结构是：先写 4 个 link（零件），再写 3 个 joint（连接），
     最后写 1 个 gazebo 插件（给车装上"驱动马达"）。
     ============================================================================ -->
<robot name="diff_car">

  <!-- ####################################################################
       零件 1：base_link —— 车体
       注意：base_link 同时也是整台车的"参考原点"。
       其它所有零件的位置，都是相对它来描述的（相对坐标）。
       #################################################################### -->
  <link name="base_link">

    <!-- visual：这个零件"长什么样"。只用于画面显示，给人看。 -->
    <visual>
      <!-- origin：这个几何体相对本零件原点的偏移和旋转。
           xyz="0 0 0" 表示不偏移，车体中心就在 base_link 原点。
           格式：xyz="x y z"（米）；rpy="roll pitch yaw"（弧度，绕 x/y/z 转） -->
      <origin xyz="0 0 0"/>
      <!-- geometry：选形状。box=长方体，size="长(x) 宽(y) 高(z)"，单位米 -->
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
      <!-- material：颜色。rgba = 红 绿 蓝 透明度，每个 0~1 -->
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>

    <!-- collision：这个零件的"碰撞形状"。
         物理引擎（Gazebo）靠它判断"有没有撞到别的东西"。
         普通情况下和 visual 写一样就行；复杂模型才会把碰撞体简化。 -->
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.30 0.20 0.10"/>
      </geometry>
    </collision>

    <!-- inertial：质量 + 转动惯量。
         物理引擎靠它算"这个物体能不能被推动、转起来有多费劲"。
         ★新手最容易漏这一段★——漏了 Gazebo 里的物体会乱飘、抖动，甚至直接报错。 -->
    <inertial>
      <origin xyz="0 0 0"/>
      <!-- 质量，单位 kg -->
      <mass value="5.0"/>
      <!-- 转动惯量：物体绕 x/y/z 三根轴转动的"惯性大小"。
           ixx/iyy/izz = 绕三根主轴的转动惯量；ixy/ixz/iyz = 耦合项（对称物体一般是 0）。
           数值 = 按形状和质量算出来的，这里车体是 0.3×0.2×0.1 的盒子、质量 5kg -->
      <inertia ixx="0.0208" ixy="0" ixz="0" iyy="0.0417" iyz="0" izz="0.0542"/>
    </inertial>
  </link>

  <!-- ####################################################################
       零件 2：left_wheel —— 左驱动轮
       #################################################################### -->
  <link name="left_wheel">
    <visual>
      <!-- ★关键点★ 圆柱体默认是"竖着"的（轴方向沿 z）。
           这里绕 x 轴转 90°（1.5708 弧度 ≈ 90°），把它"放倒"，
           让轮子的轴朝向 y 方向——这样它才像一个立在地上的轮子。
           1.5708 = 90° 转成弧度：π/2 -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <!-- cylinder = 圆柱体：radius 半径，length 长度（这里是轮子的厚度） -->
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <!-- 碰撞体要和 visual 一模一样，否则"看起来碰到、实际没碰到" -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <!-- 轮子绕"轴向"(这里是 y) 的转动惯量最大，绕另两个轴较小 -->
      <inertia ixx="0.000329" ixy="0" ixz="0" iyy="0.000625" iyz="0" izz="0.000329"/>
    </inertial>
  </link>

  <!-- ####################################################################
       零件 3：right_wheel —— 右驱动轮（结构和左轮一样）
       #################################################################### -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000329" ixy="0" ixz="0" iyy="0.000625" iyz="0" izz="0.000329"/>
    </inertial>
  </link>

  <!-- ####################################################################
       零件 4：caster_wheel —— 前万向轮
       它不提供动力，只负责"撑住车头"，防止车头前栽。
       这里我们用一个光滑小球来近似它。
       #################################################################### -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <!-- sphere = 球体，radius 半径。球体各方向对称，
             被拖着走时可以朝任意方向滑动/滚动，正好用来当万向轮 -->
        <sphere radius="0.02"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <!-- 球体三个方向的转动惯量相同 -->
      <inertia ixx="0.000032" ixy="0" ixz="0" iyy="0.000032" iyz="0" izz="0.000032"/>
    </inertial>
  </link>








  <!-- ====================================================================
       joint 1：left_wheel_joint —— 把"左轮"接到"车体"上
       ==================================================================== -->
  <joint name="left_wheel_joint" type="continuous">
    <!-- parent = 父（被连接的一方），child = 子（接上去的一方） -->
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- origin：子零件相对父零件的偏移。
         xyz="0 0.11 -0.06" 意思是：左轮在车体正左侧 0.11m、下方 0.06m 处。
         → 所以两轮之间的距离(轮距) = 0.11 × 2 = 0.22m，这个数后面插件要用 -->
    <origin xyz="0 0.11 -0.06"/>
    <!-- axis：绕哪根轴转。xyz="0 1 0" = 绕 y 轴转。
         ★这个方向极其关键★：写错方向，车就会"倒着跑"或转不起来。
         我们这里 +y 表示：绕 y 轴正方向转 → 车往 +x（正前方）走 -->
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ====================================================================
       joint 2：right_wheel_joint —— 把"右轮"接到"车体"上
       （和左轮完全对称，只是 y 变成 -0.11，在车体右侧）
       ==================================================================== -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.11 -0.06"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ====================================================================
       joint 3：caster_joint —— 把"万向轮"接到"车体"上（固定不动）
       ==================================================================== -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- 放在车体后下方：x=-0.12（往后 0.12m）、z=-0.09（往下 0.09m）。
         z=-0.09 加上球半径 0.02，球最低点刚好和两个轮子的最低点齐平，一起着地 -->
    <origin xyz="-0.12 0 -0.09"/>
    <!-- 注意：fixed 关节不需要 axis，因为它根本不会动 -->
  </joint>

  <!-- ====================================================================
       Gazebo 专用：差速驱动插件
       它的作用 = 给这台车装上"发动机 + 差速大脑"：
         1) 订阅 cmd_vel 话题（车体速度 + 角速度）
         2) 内部按"逆运动学"算出左右轮各该转多快（就是你第4课学的公式）
         3) 让 Gazebo 里的两个轮子真的转起来 → 车就动了
       ==================================================================== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- 每秒更新 30 次 -->
      <update_rate>30</update_rate>
      <!-- 指定哪两个关节是"驱动轮"，必须是上面定义过的关节名 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- ★两个尺寸必须和 URDF 里的几何对得上，否则里程计(odom)会算错★
           wheel_separation 轮距 = 0.11 × 2 = 0.22
           wheel_diameter  轮径 = 半径 0.05 × 2 = 0.10  -->
      <wheel_separation>0.22</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <!-- 轮子最大力矩 / 最大加速度（限制动力，防止太暴力） -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <!-- 订阅的话题名，你发指令就是发到这里 -->
      <command_topic>cmd_vel</command_topic>
      <!-- 里程计相关：发布的 odom 话题，以及它对应的坐标系名字 -->
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- 轮子的 TF 交给别的方式发布，这里关掉，避免两处抢着发同一个 TF -->
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>